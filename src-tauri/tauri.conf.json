{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Life Of Pi",
  "version": "0.1.0",
  "identifier": "app.lifeofpi.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Life Of Pi",
        "width": 1360,
        "height": 860,
        "minWidth": 420,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A calm daily planner",
    "longDescription": "Plan each day, timebox it, work it with a timer, and shut it down. Everything stays on this computer.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
